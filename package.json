{
  "name": "gnani",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start-react": "cd react && npm run dev",
    "start-electron-dev": "cross-env NODE_ENV=development electron .",
    "start-electron": "electron .",
    "dev": "concurrently \"npm run start-react\" \"npm run start-electron-dev\"",
    "build-react": "cd react && npm run build",
    "build": "npm run build-react && electron-builder"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.1",
    "@grpc/proto-loader": "^0.8.0",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.2",
    "electron-builder": "^26.0.12",
    "electron-reloader": "^1.2.3"
  },
  "build": {
    "appId": "com.hey.app",
    "productName": "Hey",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      {
        "from": "react/dist",
        "to": "react/dist"
      },
      "!**/*.map",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  }
}
