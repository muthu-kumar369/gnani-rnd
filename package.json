{
  "name": "hey",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start-react": "cd react && npm run dev",
    "start-electron": "electron .",
    "dev": "concurrently \"npm run start-react\" \"npm run start-electron\"",
    "build-react": "cd react && npm run build",
    "build": "npm run build-react && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^39.2.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hey.app",
    "productName": "Hey",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      {
        "from": "react/dist",
        "to": "react/dist"
      },
      "!**/*.map",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    }
  }
}